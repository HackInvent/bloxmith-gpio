{
  "kind": "gpio",
  "version": "0.1.0",
  "title": "Button & LED",
  "description": "Debounced Linux GPIO button events and bounded low-voltage LED commands through installed libgpiod 2.x.",
  "repository_url": "https://github.com/HackInvent/bloxmith-gpio",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux GPIO character devices with installed libgpiod 2.x (libgpiod.so.3), board drivers and OS permissions. Low-voltage buttons and current-limited indicator LEDs only; no automatic driver or permission changes."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "command",
        "title": "Command",
        "accepts": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "event",
        "title": "event",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "status",
        "title": "status",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "chip": "/dev/gpiochip0",
    "button_offset": -1,
    "led_offset": -1,
    "button_active_low": true,
    "led_active_low": false,
    "button_bias": "pull_up",
    "rest_active": false,
    "debounce_ms": 40,
    "poll_interval_ms": 10,
    "max_pattern_ms": 10000,
    "max_events_per_run": 10000,
    "library": "libgpiod.so.3"
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": false,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
